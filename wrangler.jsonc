{
  "name": "utilitool_bot",
  "main": "bot.js",
  "compatibility_date": "2026-09-14",

  "secrets_store_secrets": [
    {
      "binding": "TELEGRAM_BOT_TOKEN",
      "store_id": "c40cc3dcc6234fb98cab408bd2f302be",
      "secret_name": "API_ID"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "UTILITOOL_BOT_CACHE",
      "id": "caf5087e8e1c46cfb8d9caa157840038"
    }
  ],

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },

    "traces": {
      "enabled": false
    }
  }
}
